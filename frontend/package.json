{
  "name": "patch-cage-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "e2e": "playwright test --reporter=json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "7.1.9",
    "typescript": "5.9.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.37.0",
    "@eslint/js": "9.37.0",
    "typescript-eslint": "8.46.1",
    "vitest": "3.2.4",
    "@playwright/test": "1.56.1"
  }
}
